# Base de datos Neon
DATABASE_URL=

# Vercel Blob (se crea automáticamente al conectar un Blob store al proyecto)
BLOB_READ_WRITE_TOKEN=

# Base Neon exclusiva para pruebas de API (no usar la de producción)
# TEST_DATABASE_URL=

# Gemini opcional
GOOGLE_GENERATIVE_AI_API_KEY=

# Secreto usado para anonimizar claves de limitación de acceso (no usar NEXT_PUBLIC_)
AUTH_SECRET=

# Solo para ejecutar npm run auth:create-user; no conservar la contraseña aquí
# AUTH_USER_USERNAME=
# AUTH_USER_PASSWORD=
# AUTH_USER_ROLE=admin
